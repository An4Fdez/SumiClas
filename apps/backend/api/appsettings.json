{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Issuer": "sumiclas-api",
    "Audience": "sumiclas-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "RefreshGraceSeconds": 10,
    "RefreshCookie": {
      "Name": "sumiclas_refresh",
      "Path": "/api/auth",
      "Secure": true,
      "SameSite": "Strict"
    }
  }
}
